// Aarigo Capital — Prisma Schema
// Database: MySQL 8
// ORM: Prisma 5

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── User (Admin/Staff) ───────────────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  name         String   @db.VarChar(200)
  email        String   @unique @db.VarChar(255)
  mobile       String   @db.VarChar(20)
  passwordHash String   @db.Text
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payments     Payment[]
  collections  Collection[]
  dailyClosings DailyClosing[]
  auditLogs    AuditLog[]

  @@index([email])
  @@map("users")
}

// ─── Customer ─────────────────────────────────────────────────────────────────
model Customer {
  id              String         @id @default(cuid())
  customerCode    String         @unique @db.VarChar(20)  // CUS-000001
  fullName        String         @db.VarChar(200)
  mobile          String         @unique @db.VarChar(20)
  alternateMobile String?        @db.VarChar(20)
  email           String?        @db.VarChar(255)
  dateOfBirth     String?        @db.VarChar(10)          // YYYY-MM-DD
  gender          Gender?
  address         String?        @db.VarChar(500)
  addressHouse    String?        @db.VarChar(50)
  addressArea     String?        @db.VarChar(200)
  city            String?        @db.VarChar(100)
  district        String?        @db.VarChar(100)
  state           String?        @db.VarChar(100)
  pincode         String?        @db.VarChar(10)
  addressLandmark String?        @db.VarChar(200)
  occupation      String?        @db.VarChar(200)
  monthlyIncome   Decimal?       @db.Decimal(12, 2)
  // KYC
  kycType         KycType?
  kycNumber       String?        @db.VarChar(50)
  kycStatus       KycStatus      @default(PENDING)
  // Nominee
  nomineeName          String?  @db.VarChar(200)
  nomineeRelationship  String?  @db.VarChar(100)
  nomineeMobile        String?  @db.VarChar(20)
  nomineeAddress       String?  @db.VarChar(500)
  // Guarantor
  guarantorName        String?  @db.VarChar(200)
  guarantorRelationship String?  @db.VarChar(100)
  guarantorMobile      String?  @db.VarChar(20)
  guarantorAddress     String?  @db.VarChar(500)
  // Status
  status          CustomerStatus @default(ACTIVE)
  notes           String?        @db.Text
  photoPath       String?        @db.VarChar(500)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  loans        Loan[]
  payments     Payment[]
  collections  Collection[]
  visits       Visit[]
  routes       Route[]
  documents    CustomerDocument[]
  auditLogs    AuditLog[]

  @@index([mobile])
  @@index([customerCode])
  @@index([status])
  @@map("customers")
}

// ─── Customer Document ────────────────────────────────────────────────────────
model CustomerDocument {
  id             String            @id @default(cuid())
  customerId     String
  documentType   DocumentType
  documentNumber String?           @db.VarChar(100)
  fileName       String            @db.VarChar(255)
  filePath       String            @db.VarChar(500)
  mimeType       String?           @db.VarChar(100)
  fileSizeBytes  Int?
  expiryDate     String?           @db.VarChar(10)
  verificationStatus VerificationStatus @default(PENDING)
  verificationNotes  String?       @db.Text
  uploadedAt     DateTime          @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([documentType])
  @@map("customer_documents")
}

// ─── Loan Product ─────────────────────────────────────────────────────────────
model LoanProduct {
  id                 String       @id @default(cuid())
  name               String       @unique @db.VarChar(200)
  description        String?      @db.Text
  minAmount          Decimal      @db.Decimal(12, 2)
  maxAmount          Decimal      @db.Decimal(12, 2)
  interestRate       Decimal      @db.Decimal(5, 2)       // Annual %
  interestType       InterestType
  defaultTenure      Int                                   // In frequency units
  repaymentFrequency Frequency
  processingFee      Decimal      @default(0) @db.Decimal(10, 2)
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  loans Loan[]

  @@map("loan_products")
}

// ─── Loan ─────────────────────────────────────────────────────────────────────
model Loan {
  id               String     @id @default(cuid())
  loanNumber       String     @unique @db.VarChar(20)     // LN-000001
  customerId       String
  loanProductId    String?

  principalAmount  Decimal    @db.Decimal(12, 2)
  interestRate     Decimal    @db.Decimal(5, 2)           // Annual %
  interestType     InterestType
  tenure           Int                                     // In frequency units
  frequency        Frequency
  processingFee    Decimal    @default(0) @db.Decimal(10, 2)
  insurance        Decimal    @default(0) @db.Decimal(10, 2)

  emiAmount        Decimal    @db.Decimal(12, 2)
  totalInterest    Decimal    @db.Decimal(12, 2)
  totalPayable     Decimal    @db.Decimal(12, 2)

  startDate        String     @db.VarChar(10)             // YYYY-MM-DD
  firstDueDate     String     @db.VarChar(10)
  maturityDate     String     @db.VarChar(10)

  paidAmount       Decimal    @default(0) @db.Decimal(12, 2)
  outstandingAmount Decimal   @db.Decimal(12, 2)
  overdueAmount    Decimal    @default(0) @db.Decimal(12, 2)

  purpose              String?  @db.VarChar(500)
  disbursementMethod   String?  @db.VarChar(50)
  bankTransactionId    String?  @db.VarChar(200)

  status           LoanStatus @default(ACTIVE)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  customer     Customer     @relation(fields: [customerId], references: [id])
  loanProduct  LoanProduct? @relation(fields: [loanProductId], references: [id])
  installments Installment[]
  payments     Payment[]
  collections  Collection[]
  visits       Visit[]
  routes       Route[]
  receipts     Receipt[]

  @@index([customerId])
  @@index([loanNumber])
  @@index([status])
  @@index([maturityDate])
  @@map("loans")
}

// ─── Installment ──────────────────────────────────────────────────────────────
model Installment {
  id                 String            @id @default(cuid())
  loanId             String
  installmentNumber  Int
  dueDate            String            @db.VarChar(10)     // YYYY-MM-DD
  principalAmount    Decimal           @db.Decimal(12, 2)
  interestAmount     Decimal           @db.Decimal(12, 2)
  totalAmount        Decimal           @db.Decimal(12, 2)
  paidAmount         Decimal           @default(0) @db.Decimal(12, 2)
  outstandingAmount  Decimal           @db.Decimal(12, 2)
  status             InstallmentStatus @default(PENDING)
  paidAt             DateTime?
  lateFee            Decimal?          @db.Decimal(10, 2)
  lateFeePaid        Decimal?          @db.Decimal(10, 2)
  lateFeeWaived      Boolean           @default(false)
  remarks            String?           @db.VarChar(500)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@unique([loanId, installmentNumber])
  @@index([loanId])
  @@index([dueDate])
  @@index([status])
  @@map("installments")
}

// ─── Payment ──────────────────────────────────────────────────────────────────
model Payment {
  id              String        @id @default(cuid())
  paymentNumber   String        @unique @db.VarChar(30)   // PAY-000001
  loanId          String
  customerId      String
  createdByUserId String?
  amount          Decimal       @db.Decimal(12, 2)
  paymentDate     String        @db.VarChar(10)           // YYYY-MM-DD
  paymentMethod   PaymentMethod
  referenceNumber String?       @db.VarChar(200)
  notes           String?       @db.Text
  isReversed      Boolean       @default(false)
  reversalReason  String?       @db.Text
  isEarlyClosure  Boolean       @default(false)
  lateFeePaid     Decimal?      @db.Decimal(10, 2)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  loan       Loan        @relation(fields: [loanId], references: [id])
  customer   Customer    @relation(fields: [customerId], references: [id])
  createdBy  User?       @relation(fields: [createdByUserId], references: [id])
  receipt    Receipt?
  collection Collection?

  @@index([loanId])
  @@index([customerId])
  @@index([paymentDate])
  @@index([paymentNumber])
  @@map("payments")
}

// ─── Collection ───────────────────────────────────────────────────────────────
model Collection {
  id              String        @id @default(cuid())
  loanId          String
  customerId      String
  paymentId       String?       @unique
  collectedByUserId String?
  collectionDate  String        @db.VarChar(10)
  amount          Decimal       @db.Decimal(12, 2)
  paymentMethod   PaymentMethod
  referenceNumber String?       @db.VarChar(200)
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())

  loan        Loan     @relation(fields: [loanId], references: [id])
  customer    Customer @relation(fields: [customerId], references: [id])
  payment     Payment? @relation(fields: [paymentId], references: [id])
  collectedBy User?    @relation(fields: [collectedByUserId], references: [id])

  @@index([loanId])
  @@index([customerId])
  @@index([collectionDate])
  @@map("collections")
}

// ─── Receipt ──────────────────────────────────────────────────────────────────
model Receipt {
  id            String   @id @default(cuid())
  receiptNumber String   @unique @db.VarChar(30)           // RCP-2026-00001
  paymentId     String   @unique
  loanId        String
  generatedAt   DateTime @default(now())
  filePath      String?  @db.VarChar(500)
  status        String   @default("ISSUED") @db.VarChar(20)

  payment Payment @relation(fields: [paymentId], references: [id])
  loan    Loan    @relation(fields: [loanId], references: [id])

  @@index([receiptNumber])
  @@index([loanId])
  @@map("receipts")
}

// ─── Visit ────────────────────────────────────────────────────────────────────
model Visit {
  id         String      @id @default(cuid())
  customerId String
  loanId     String
  visitDate  String      @db.VarChar(10)
  purpose    String?     @db.VarChar(500)
  status     VisitStatus @default(PLANNED)
  notes      String?     @db.Text
  location   String?     @db.VarChar(500)
  dueAmount  Decimal?    @db.Decimal(12, 2)
  collected  Decimal?    @db.Decimal(12, 2)
  nextVisit  String?     @db.VarChar(10)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  loan     Loan     @relation(fields: [loanId], references: [id])

  @@index([customerId])
  @@index([loanId])
  @@index([visitDate])
  @@map("visits")
}

// ─── Route ────────────────────────────────────────────────────────────────────
model Route {
  id               String       @id @default(cuid())
  routeDate        String       @db.VarChar(10) // YYYY-MM-DD
  customerId       String
  loanId           String?
  sequence         Int          @default(0)
  visitStatus      VisitStatus  @default(PLANNED)
  collectionStatus String       @default("PENDING") @db.VarChar(20) // PENDING, COLLECTED, FAILED
  amountDue        Decimal?     @db.Decimal(12, 2)
  amountCollected  Decimal?     @db.Decimal(12, 2)
  notes            String?      @db.Text
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  loan     Loan?    @relation(fields: [loanId], references: [id])

  @@index([routeDate])
  @@index([customerId])
  @@index([loanId])
  @@map("routes")
}

// ─── Daily Closing ────────────────────────────────────────────────────────────
model DailyClosing {
  id                String         @id @default(cuid())
  closingDate       String         @unique @db.VarChar(10) // YYYY-MM-DD
  totalDue          Decimal        @db.Decimal(14, 2)
  totalCollected    Decimal        @db.Decimal(14, 2)
  shortfall         Decimal        @db.Decimal(14, 2)
  collectionRate    Decimal        @db.Decimal(5, 2)
  cashAmount        Decimal        @default(0) @db.Decimal(14, 2)
  cashCount         Int            @default(0)
  upiAmount         Decimal        @default(0) @db.Decimal(14, 2)
  upiCount          Int            @default(0)
  bankAmount        Decimal        @default(0) @db.Decimal(14, 2)
  bankCount         Int            @default(0)
  transactionsCount Int            @default(0)
  visitsCount       Int            @default(0)
  status            ClosingStatus  @default(OPEN)
  closedByUserId    String?
  closedAt          DateTime?
  notes             String?        @db.Text
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  closedBy User? @relation(fields: [closedByUserId], references: [id])

  @@index([closingDate])
  @@map("daily_closings")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────
model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  customerId  String?
  entityType  String   @db.VarChar(50)    // e.g. "Loan", "Payment"
  entityId    String   @db.VarChar(100)
  action      String   @db.VarChar(50)    // e.g. "CREATE", "UPDATE", "CLOSE"
  oldValue    Json?
  newValue    Json?
  reason      String?  @db.Text
  ipAddress   String?  @db.VarChar(50)
  requestId   String?  @db.VarChar(100)
  createdAt   DateTime @default(now())

  user     User?     @relation(fields: [userId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([userId])
  @@index([customerId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Enums ────────────────────────────────────────────────────────────────────
enum Gender {
  MALE
  FEMALE
  OTHER
}

enum KycType {
  AADHAAR
  PAN
  VOTER_ID
  DRIVING_LICENCE
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum DocumentType {
  AADHAAR
  PAN
  ADDRESS_PROOF
  INCOME_PROOF
  BANK_STATEMENT
  PHOTO
  OTHER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum InterestType {
  FLAT
  REDUCING
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum LoanStatus {
  PENDING
  ACTIVE
  OVERDUE
  CLOSED
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
  OTHER
}

enum VisitStatus {
  PLANNED
  VISITED
  PAID
  PARTIALLY_PAID
  NOT_PAID
}

enum ClosingStatus {
  OPEN
  CLOSED
  AUDITED
}
