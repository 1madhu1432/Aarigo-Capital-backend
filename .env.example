# ─── Aarigo Capital Backend — Environment Variables ───────────────────────────
# Copy this file to .env and fill in the values before running the backend.
# NEVER commit .env with real credentials.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# MySQL 8 connection string
DATABASE_URL="mysql://aarigo_test:YOUR_PASSWORD@localhost:3306/aarigo_capital_test"

# ── Authentication ────────────────────────────────────────────────────────────
# Generate a strong random secret — e.g: openssl rand -hex 64
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_MINIMUM_64_CHARS
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# ── File Uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
AUTH_RATE_LIMIT_MAX=10

# ── Seed (Development Only) ───────────────────────────────────────────────────
# Password used for the seeded admin user (development only)
SEED_ADMIN_EMAIL=admin@aarigocapital.com
SEED_ADMIN_PASSWORD=CHANGE_THIS_SEED_PASSWORD
